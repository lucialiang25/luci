# ──────────────────────────────────────────────────────────────
# SchoolMail Bridge — environment template
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file or real credentials.
# ──────────────────────────────────────────────────────────────

# General application settings
APP_NAME=SchoolMail Bridge
ENVIRONMENT=development
DEBUG=true

# Email account (sample placeholders only — replace in .env)
EMAIL_ADDRESS=your_email@gmail.com
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# Login method: oauth2 (default, IMAP XOAUTH2) or app_password
EMAIL_AUTH_METHOD=oauth2
# Google Cloud "Desktop app" OAuth client JSON, then run: python -m app.gmail_oauth
GMAIL_OAUTH_CLIENT_FILE=.secrets/google_oauth_client.json
GMAIL_OAUTH_TOKEN_FILE=.secrets/gmail_token.json
# Only used when EMAIL_AUTH_METHOD=app_password
EMAIL_APP_PASSWORD=replace_with_app_specific_password
SMTP_SERVER=smtp.example.com
SMTP_PORT=587

# Translation service (sample placeholder only)
TRANSLATION_API_KEY=replace_with_your_api_key
TRANSLATION_API_BASE_URL=https://api.example-translator.com

# Duplicate-prevention secret for email fingerprints (HMAC-SHA256 key).
# MUST be >= 32 characters. Generate a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
EMAIL_FINGERPRINT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Logging
LOG_LEVEL=INFO
